# ─────────────────────────────────────────────────────────────────────────────
# llm-proxy — the sandbox's ONLY route to the outside world.
#
# Rendered at container start by the nginx image's envsubst step
# (/etc/nginx/templates/*.template → /etc/nginx/conf.d/*.conf).
#
# Security properties:
#   • Allowlist egress: only the OpenAI-compatible API surface of ONE upstream
#     host (${LLM_UPSTREAM_HOST}) is reachable. Everything else → 403.
#   • Credential isolation: the real API key lives only in this container.
#     Agents in the sandbox hold a dummy key; this proxy overwrites the
#     Authorization header, so a hijacked agent has no real secret to leak.
#   • Runtime DNS (resolver + variable proxy_pass): no hard-coded upstream IPs.
#   • The upstream's TLS certificate is VERIFIED. nginx does not do this by
#     default, so without proxy_ssl_verify the key would be handed to anything
#     that answered for ${LLM_UPSTREAM_HOST} — a spoofed DNS answer was enough.
#   • Only the NORMALISED path is forwarded. The allowlist matches nginx's
#     decoded, dot-resolved $uri, but a bare `proxy_pass https://$host` sends
#     the client's RAW request line: `/openai/v1/files/..%2F..%2Fv1/models`
#     matched the allowlist and reached the upstream as a files-API call,
#     carrying the real key. `$uri` here can only be one of the four exact
#     strings the location regex accepts.
# ─────────────────────────────────────────────────────────────────────────────

resolver ${LLM_PROXY_RESOLVER} valid=300s ipv6=off;
resolver_timeout 5s;
server_tokens off;

server {
    listen 11434;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }

    # OpenAI-compatible API only (Groq serves it under /openai/v1, OpenAI under /v1).
    location ~ ^/(openai/)?v1/(chat/completions|models)$ {
        set $llm_upstream ${LLM_UPSTREAM_HOST};

        # $uri, not the raw request: see the header. No query string either —
        # neither endpoint takes one.
        proxy_pass https://$llm_upstream$uri;
        proxy_http_version 1.1;
        proxy_set_header Host $llm_upstream;
        proxy_set_header Authorization "Bearer ${LLM_API_KEY}";
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
        proxy_ssl_name $llm_upstream;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 4;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        client_max_body_size 2m;
    }

    location / {
        default_type text/plain;
        return 403 "creuset llm-proxy: egress denied\n";
    }
}
