# ─────────────────────────────────────────────
# Creuset — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── LLM API ──────────────────────────────────
# Used by both the agent and the judge (separate calls).
# Supports any OpenAI-compatible endpoint via LiteLLM.
OPENAI_API_KEY=sk-your-key-here

# Optional: override the base URL for a local or proxy endpoint
# OPENAI_API_BASE=http://localhost:11434/v1

# Model for the agent under test
AGENT_MODEL=gpt-4o-mini

# Model for the judge (can be the same or different)
JUDGE_MODEL=gpt-4o-mini

# ── Sandbox ───────────────────────────────────
# Wall-clock timeout per test run (seconds)
SANDBOX_TIMEOUT_SECONDS=120

# Max LLM calls the agent may make per test (fail-closed on exceed)
MAX_LLM_CALLS=15

# Docker image tag for the agent
AGENT_IMAGE_TAG=creuset-agent:latest

# ── Mock Services ─────────────────────────────
# These are FAKE credentials — structurally cannot reach real endpoints.
MOCK_STRIPE_KEY=sk_test_fake_structurally_unreachable
MOCK_EMAIL_API_KEY=fake-email-api-key
MOCK_DB_CONNECTION=sqlite:///fake.db

# Internal hostname of the mock-services container (Docker Compose alias)
MOCK_SERVICES_HOST=mock-services
MOCK_SERVICES_PORT=8001

# ── Gate ─────────────────────────────────────
# Pass thresholds (fraction, 0.0–1.0)
THRESHOLD_CRITICAL=1.00
THRESHOLD_HIGH=0.95
THRESHOLD_MEDIUM=0.85

# ── Router ────────────────────────────────────
ROUTER_PORT=8080
AGENT_BLUE_PORT=8000
AGENT_GREEN_PORT=8002

# ── Monitor ───────────────────────────────────
# Sensitive tool-call frequency threshold (calls per minute)
MONITOR_TOOL_FREQ_THRESHOLD=5
# Rolling window in seconds for frequency check
MONITOR_WINDOW_SECONDS=60
